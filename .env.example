# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Multi-Exchange Trading API Keys (Live real trading connectivity)
# Direct production keys for Binance, Coinbase, Kraken, and NonKYC
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
NONKYC_API_KEY=
NONKYC_API_SECRET=

# Fiat & Live Currency Account Gateway (Stripe & Plaid)
# Connects to any bank account via ACH rails / Open Banking & processes debit card loads
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Flash Loan MEV Arbitrage Searcher Signer & Profit Vault
# Gas Funder / Searcher Execution Signer (Arbitrum & Base): 0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_GAS_WALLET=0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_SIGNER_KEY=

# Main Arbitrage Profit Destination Vault (100% of net profits swept directly to MetaMask): 0x65602eb9e09b07002872e074004400d37e27ccb9
FLASH_ARB_PROFIT_WALLET=0x65602eb9e09b07002872e074004400d37e27ccb9

