# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Multi-Exchange Trading API Keys (Live real trading connectivity)
# Direct production keys for Binance, Coinbase, Kraken, and NonKYC
# --- Server access control (REQUIRED) ---
# The API is deny-by-default. Only these Firebase accounts may call /api. Without one of them every /api route returns 503.
ALLOWED_EMAILS=
ALLOWED_UIDS=
# FIREBASE_PROJECT_ID defaults to firebase-applet-config.json
FIREBASE_PROJECT_ID=

# --- Server-side trading guardrails (also editable at runtime; persisted in data/risk-settings.json) ---
TRADING_FROZEN=false
MAX_SINGLE_ORDER_USD=500
MAX_DAILY_NOTIONAL_USD=5000
MAX_DAILY_LOSS_USD=

# Optional: Gemini model override, Binance base override, assumed gas for flash-arb estimates
GEMINI_MODEL=
BINANCE_API_BASE=
FLASH_ARB_ASSUMED_GAS=350000

BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Coinbase: CDP API key name as KEY, EC private key PEM (ES256) as SECRET (use \n for newlines)
BYBIT_API_KEY=
BYBIT_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
NONKYC_API_KEY=
NONKYC_API_SECRET=

# Fiat rails (Stripe & Plaid): NOT implemented. These endpoints return 501; the variables are currently unused.
# Connects to any bank account via ACH rails / Open Banking & processes debit card loads
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Flash Loan MEV Arbitrage Searcher Signer & Profit Vault
# Gas Funder / Searcher Execution Signer (Arbitrum & Base): 0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_GAS_WALLET=0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_SIGNER_KEY=

# Main Arbitrage Profit Destination Vault (100% of net profits swept directly here): 0xc102BB3848DD0397dEB6C655721F756Aa9F9f15d
FLASH_ARB_PROFIT_WALLET=0xc102BB3848DD0397dEB6C655721F756Aa9F9f15d


# Searcher RPC endpoints (override the public defaults in flash-arb/searcher/config/*.toml)
RPC_HTTP_ARBITRUM=
RPC_HTTP_BASE=
RPC_HTTP_OPTIMISM=
